{
  "name": "offline-vastness",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "qa": "node scripts/sanctuary-look.mjs",
    "qa:controls": "node scripts/sanctuary-controls.mjs",
    "qa:devices": "node scripts/sanctuary-devices.mjs",
    "qa:performance": "node scripts/sanctuary-performance.mjs",
    "qa:resilience": "node scripts/sanctuary-resilience.mjs",
    "qa:onboarding": "node scripts/vastness-onboarding.mjs",
    "qa:touch-guide": "node scripts/vastness-touch-guide.mjs",
    "qa:encounters": "node scripts/vastness-encounters.mjs",
    "qa:approaches": "node scripts/vastness-approaches.mjs",
    "qa:walk": "node scripts/vastness-walk.mjs",
    "qa:pilgrim": "node scripts/pilgrim-smoke.mjs",
    "qa:journey": "node scripts/pilgrim-journey.mjs",
    "qa:lab": "node scripts/pilgrim-lab.mjs",
    "qa:living-cosmos": "node scripts/living-cosmos.mjs",
    "replay:rgbd": "node --experimental-strip-types scripts/replay-rgbd.ts",
    "qa:place": "node scripts/sanctuary-journey.mjs",
    "test:reconstruction": "python -m unittest discover -s tests -p test_reconstruction_report.py"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.0"
  }
}
