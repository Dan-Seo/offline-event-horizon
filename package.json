{
  "name": "offline-vastness",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "qa": "node scripts/vastness-look.mjs",
    "qa:controls": "node scripts/vastness-controls.mjs",
    "qa:devices": "node scripts/vastness-devices.mjs",
    "qa:performance": "node scripts/vastness-performance.mjs",
    "qa:resilience": "node scripts/vastness-resilience.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "typescript": "^5.9.0"
  }
}
